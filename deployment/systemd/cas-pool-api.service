[Unit]
Description=Cascoin pool: public API (127.0.0.1:8125)
After=cas-pool-redis.service cas-node.service
Requires=cas-pool-redis.service
[Service]
Type=simple
User=caspool
WorkingDirectory=/opt/cas-nodejs-pool
ExecStart=/usr/bin/node /opt/cas-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
