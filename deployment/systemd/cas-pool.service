[Unit]
Description=Cascoin pool: stratum server (miners, share checking with the rxhash helper, block submission)
After=cas-pool-redis.service cas-node.service
Requires=cas-pool-redis.service
[Service]
Type=simple
User=caspool
WorkingDirectory=/opt/cas-nodejs-pool
ExecStart=/usr/bin/node /opt/cas-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
