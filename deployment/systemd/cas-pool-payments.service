[Unit]
Description=Cascoin pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=cas-pool-redis.service cas-node.service
Requires=cas-pool-redis.service
[Service]
Type=simple
User=caspool
WorkingDirectory=/opt/cas-nodejs-pool
ExecStart=/usr/bin/node /opt/cas-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
